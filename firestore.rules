rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data;
    }

    function isMember(tontineId) {
      return signedIn() && profile().tontineId == tontineId;
    }

    function isAdmin(tontineId) {
      return signedIn() &&
          get(/databases/$(database)/documents/tontines/$(tontineId)).data.adminUid == request.auth.uid;
    }

    match /utilisateurs/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /tontines/{tontineId} {
      allow read: if isMember(tontineId);
      allow create: if signedIn() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if isAdmin(tontineId);

      // Un membre invité peut uniquement réclamer son placeholder. La fiche
      // doit encore être libre, le code doit désigner cette même fiche et
      // aucune autre donnée du membre ne peut être modifiée à cette étape.
      match /membres/{membreId} {
        allow read: if isMember(tontineId);
        // Une personne invitée peut réclamer son propre placeholder (fiche
        // encore libre, code désignant cette même fiche, aucune autre donnée
        // modifiée à cette étape) ...
        //
        // `creerMembrePlaceholder` omet entièrement la clé `uid` (au lieu
        // d'écrire `uid: null`) : `resource.data.uid` accédé directement sur
        // un placeholder jamais réclamé lèverait une erreur d'évaluation
        // (propriété indéfinie), ce qui refuse la règle entière — d'où
        // `get(..., null)`, qui renvoie bien `null` si la clé est absente.
        allow update: if signedIn() &&
            resource.data.get('uid', null) == null &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['uid', 'codeInvitationUtilise']) &&
            get(/databases/$(database)/documents/invitations/
                $(request.resource.data.codeInvitationUtilise)).data.tontineId == tontineId &&
            get(/databases/$(database)/documents/invitations/
                $(request.resource.data.codeInvitationUtilise)).data.membreId == membreId;
        // ... ou l'administratrice peut librement gérer les fiches de sa
        // tontine (coordonnées, activation, code d'invitation dénormalisé).
        allow update: if isAdmin(tontineId);
        allow create, delete: if isAdmin(tontineId);
      }

      match /declarations/{declarationId} {
        allow read: if isMember(tontineId);
        // Le membre doit détenir une part du nom déclaré (membreIds,
        // dénormalisé sur le nom à partir de `parts` — voir NomModel) : sans
        // cette vérification, n'importe quel membre pourrait déclarer un
        // paiement pour le nom de quelqu'un d'autre.
        allow create: if isMember(tontineId) &&
            request.resource.data.membreId == profile().membreId &&
            request.resource.data.statut == 'enAttente' &&
            get(/databases/$(database)/documents/tontines/$(tontineId)/noms/
                $(request.resource.data.nomId)).data.membreIds
                .hasAny([profile().membreId]);
        allow update: if isAdmin(tontineId);
        allow delete: if false;
      }

      // Une preuve (photo compressée) est un fichier immuable une fois
      // envoyé : un membre doit pouvoir joindre la sienne à sa déclaration
      // (le catch-all `{subcollection}` ci-dessous réserverait l'écriture à
      // l'administratrice), mais personne ne peut la modifier ni la
      // supprimer ensuite.
      match /preuves/{preuveId} {
        allow read: if isMember(tontineId);
        allow create: if isMember(tontineId);
        allow update, delete: if false;
      }

      // Suivi de l'e-mail d'invitation envoyé à un nouveau membre. Écrit
      // UNIQUEMENT par la Cloud Function `envoyerEmailInvitation` (Admin SDK,
      // qui contourne ces règles) : aucun client ne peut le créer ni le
      // falsifier. Seule l'administratrice le lit (il contient l'adresse du
      // destinataire et l'éventuelle cause d'échec).
      match /envoisInvitation/{membreId} {
        allow read: if isAdmin(tontineId);
        allow write: if false;
      }

      // Couvre les autres sous-collections (noms, tours, cotisations,
      // changements). `declarations`, `preuves` et `envoisInvitation` sont
      // exclues : Firestore évalue TOUTES les règles dont le chemin
      // correspond et autorise dès que L'UNE d'elles l'autorise — sans cette
      // exclusion, ce bloc rouvrirait la lecture ou l'écriture que leurs
      // blocs dédiés ci-dessus restreignent explicitement.
      match /{subcollection}/{documentId} {
        allow read: if isMember(tontineId) && subcollection != 'envoisInvitation';
        allow write: if isAdmin(tontineId) &&
            !(subcollection in ['declarations', 'preuves', 'envoisInvitation']);
      }
    }

    match /invitations/{code} {
      // Lecture publique : le document ne contient qu'un instantané
      // dénormalisé (tontineId, membreId, nomTontine, nombreMembres), utile à
      // l'écran d'adhésion pour prévisualiser la tontine avant la création
      // d'un compte. Il faut connaître le code exact (pas de `list`), et les
      // documents `tontines`/`membres` complets restent réservés aux membres.
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin(request.resource.data.tontineId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
